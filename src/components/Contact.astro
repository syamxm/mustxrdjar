---
import Badge from './Badge.astro';

const socials = ['instagram', 'whatsapp', 'tiktok'];
---

<section class="band" id="commissions">
  <header class="band__head">
    <h2 class="band__title">commissions</h2>
  </header>

  <div class="contact">
    <div class="contact__say">
      <p class="prose">
        commissions are <span class="scrawl contact__open">open</span>. tell me what you
        want made and when you need it.
      </p>

      <!-- CONTACT EMAIL -->
      <p class="contact__line" data-placeholder>
        <a href="#" class="contact__email">your@email.here</a>
      </p>

      <ul class="contact__socials">
        <!-- SOCIAL: instagram -->
        <!-- SOCIAL: whatsapp -->
        <!-- SOCIAL: tiktok -->
        {socials.map((name) => (
          <li>
            <a href="#" data-placeholder>{name}</a>
          </li>
        ))}
      </ul>
    </div>

    <Badge rot={-7} plate={1} size="clamp(8rem, 6rem + 9vw, 12rem)">
      <span>commissions<br />open</span>
    </Badge>
  </div>
</section>

<style>
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .contact__say {
    flex: 1 1 26rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact__open {
    color: var(--accent);
    font-size: 1.25em;
  }

  .contact__email {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

  .contact__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .contact__socials a {
    font-size: var(--text-sm);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
</style>
