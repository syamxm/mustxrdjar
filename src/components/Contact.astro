---
import Badge from './Badge.astro';
import Sticker from './Sticker.astro';
import { email, mailto, socials } from '../data/contact.js';
---

<section class="band" id="commissions">
  <header class="band__head">
    <h2 class="band__title">commissions</h2>
  </header>

  <div class="contact">
    <div class="contact__say">
      <p class="prose">
        commissions are <span class="scrawl contact__open">open</span>. tell me what you
        want made and when you need it.
      </p>

      <p class="contact__line">
        <a class="contact__email" href={mailto}>
          <Sticker rot={-1.5} plate={3}>
            <span class="contact__email-word">{email}</span>
          </Sticker>
        </a>
      </p>

      <ul class="contact__socials">
        {socials.map(({ name, href }) => (
          <li>
            <a href={href} rel="me noopener" target="_blank">
              {name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <Badge rot={-7} plate={1} size="clamp(8rem, 6rem + 9vw, 12rem)">
      <span>commissions<br />open</span>
    </Badge>
  </div>
</section>

<style>
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .contact__say {
    flex: 1 1 26rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact__open {
    color: var(--accent);
    font-size: 1.25em;
  }

  .contact__line {
    display: flex;
  }

  .contact__email {
    text-decoration: none;
  }

  .contact__email-word {
    display: block;
    padding: 0.1em 0.4em 0.24em;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 0.55rem + 2.2vw, 1.75rem);
    line-height: 0.9;
  }

  .contact__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .contact__socials a {
    font-size: var(--text-sm);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
</style>
