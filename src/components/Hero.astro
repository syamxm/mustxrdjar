---
import ArtSticker from './ArtSticker.astro';
import Sticker from './Sticker.astro';
import Badge from './Badge.astro';
import { painted, sketched } from '../data/artworks.js';

function pick(list, slug) {
  const found = list.find((item) => item.slug === slug);
  if (!found) throw new Error(`Hero references missing artwork: ${slug}`);
  return found;
}

const collage = [
  { art: pick(painted, 'painted-05'), l: 2, t: 4, w: 17, rot: -5, plate: 5, z: 2 },
  { art: pick(painted, 'painted-12'), l: 15, t: 26, w: 17, rot: 3, plate: 2, z: 4 },
  { art: pick(painted, 'painted-14'), l: 27, t: 2, w: 20, rot: -3, plate: 1, z: 3 },
  { art: pick(painted, 'painted-06'), l: 44, t: 22, w: 19, rot: 4, plate: 3, z: 5 },
  { art: pick(painted, 'painted-11'), l: 60, t: 0, w: 18, rot: -4, plate: 6, z: 3 },
  { art: pick(sketched, 'sketched-04'), l: 74, t: 24, w: 18, rot: 2, plate: 4, z: 2 },
];
---

<header class="hero">
  <div class="hero__stage">
    {
      collage.map(({ art, l, t, w, rot, plate, z }) => (
        <ArtSticker
          artwork={{ ...art, rot, plate }}
          class="hero__art"
          style={`--l:${l}%;--t:${t}%;--w:${w}%;--z:${z}`}
          widths={[240, 360, 520, 760]}
          sizes="(max-width: 62rem) 44vw, 18vw"
          loading="eager"
        />
      ))
    }

  </div>

  <div class="hero__mark">
    <div class="hero__name">
      <h1 class="wordmark">mustxrdjar</h1>
      <p class="hero__count">22 pieces. painted and sketched.</p>
    </div>
  </div>

  <div class="hero__foot">
    <nav class="hero__nav" aria-label="bodies of work">
      <a href="#painted">
        <Sticker rot={-2.5} plate={2}><span class="hero__word">painted</span></Sticker>
      </a>
      <a href="#sketched">
        <Sticker rot={3} plate={4}><span class="hero__word">sketched</span></Sticker>
      </a>
    </nav>
    <Badge rot={-7} plate={1} size="clamp(8rem, 6rem + 9vw, 12rem)">
      <span>commissions<br />open</span>
    </Badge>
  </div>
</header>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-block: var(--space-md) var(--space-xl);
  }

  .hero__stage {
    position: relative;
    aspect-ratio: 2.87 / 1;
  }

  .hero__stage :global(.hero__art) {
    position: absolute;
    left: var(--l);
    top: var(--t);
    width: var(--w);
    z-index: var(--z);
  }

  .hero__stage :global(.hero__art:hover),
  .hero__stage :global(.hero__art:focus-within) {
    z-index: 6;
  }

  .hero__mark {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .hero__count {
    margin-top: var(--space-xs);
    font-size: var(--text-lg);
    text-transform: lowercase;
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .hero__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
  }

  .hero__nav a {
    text-decoration: none;
  }

  .hero__word {
    display: block;
    padding: 0.1em 0.4em 0.24em;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 0.9;
  }

  @media (max-width: 62rem) {
    .hero__stage {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
      gap: var(--space-lg) var(--space-md);
      aspect-ratio: auto;
    }

    .hero__stage :global(.hero__art) {
      position: static;
      width: auto;
    }

    .hero__stage :global(.hero__art:nth-child(even)) {
      margin-top: var(--space-xl);
    }

    .hero__mark {
      justify-content: flex-start;
    }
  }

  @media (max-width: 40rem) {
    .hero__stage {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
