---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import Lightbox from '../components/Lightbox.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import StarGap from '../components/StarGap.astro';
import { painted, sketched } from '../data/artworks.js';

const selectedSlugs = ['painted-09', 'painted-13', 'painted-02', 'sketched-06', 'painted-04'];
const bySlug = new Map([...painted, ...sketched].map((item) => [item.slug, item]));
const selected = selectedSlugs.map((slug) => bySlug.get(slug));
---

<Base
  title="mustxrdjar"
  description="Painted and sketched work by mustxrdjar. Commissions open."
>
  <main class="page">
    <Hero />

    <StarGap arrangement={0} />

    <Gallery id="selected" heading="selected" items={selected} variant="row" rotScale={1} />

    <StarGap arrangement={1} />

    <Gallery
      id="painted"
      heading="painted"
      count="15 pieces"
      items={painted}
      variant="dense"
      rotScale={1}
    />

    <StarGap arrangement={2} />

    <Gallery
      id="sketched"
      heading="sketched"
      count="7 pieces"
      items={sketched}
      variant="sparse"
      rotScale={0.3}
    />
    <StarGap arrangement={3} />

    <About />
    <StarGap arrangement={4} />

    <Contact />
    <Footer />
  </main>

  <Lightbox />
</Base>
