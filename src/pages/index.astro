---
import Base from '../layouts/Base.astro';
import Sticker from '../components/Sticker.astro';
import ArtSticker from '../components/ArtSticker.astro';
import Badge from '../components/Badge.astro';
import { painted, nonPainted } from '../data/artworks.js';

const plates = [
  ['red', '#e4141b'],
  ['orange', '#f26430'],
  ['chrome', '#ffc400'],
  ['cobalt', '#1b3faf'],
  ['grass', '#3e8e2e'],
  ['gum', '#f06e9e'],
];

const scale = [
  ['3xl', 'var(--text-3xl)', 'display'],
  ['2xl', 'var(--text-2xl)', 'display'],
  ['xl', 'var(--text-xl)', 'display'],
  ['lg', 'var(--text-lg)', 'body'],
  ['base', 'var(--text-base)', 'body'],
  ['sm', 'var(--text-sm)', 'body'],
];

const demo = [painted[5], painted[7], nonPainted[2]];
---

<Base
  title="mustxrdjar — design system"
  description="Design system proof sheet for the mustxrdjar portfolio."
>
  <main class="page sheet">
    <section class="block">
      <p class="eyebrow">the wall</p>
      <h1 class="wordmark">mustxrdjar</h1>
      <div class="badge-row">
        <Badge rot={-7} plate={1}><span>commissions<br />open</span></Badge>
        <Badge rot={5} plate={3} face="var(--gum)"><span>22<br />pieces</span></Badge>
      </div>
    </section>

    <section class="block">
      <p class="eyebrow">plates</p>
      <ul class="plates">
        {
          plates.map(([name, hex]) => (
            <li>
              <span class="plates__chip" style={`background:${hex}`}></span>
              <span class="plates__name">{name}</span>
              <span class="plates__hex">{hex}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block">
      <p class="eyebrow">type</p>
      <ul class="scale">
        {
          scale.map(([name, size, face]) => (
            <li>
              <span class="scale__label">{name}</span>
              <span
                class="scale__spec"
                style={`font-size:${size};font-family:var(--font-${face})`}
              >
                painted / non-painted
              </span>
            </li>
          ))
        }
        <li>
          <span class="scale__label">marker</span>
          <span class="scale__spec scrawl" style="font-size:var(--text-xl)">open</span>
        </li>
      </ul>
    </section>

    <section class="block">
      <p class="eyebrow">nav stickers</p>
      <div class="nav-row">
        <Sticker rot={-2.5} plate={2}><span class="nav-row__word">painted</span></Sticker>
        <Sticker rot={3} plate={4}><span class="nav-row__word">non-painted</span></Sticker>
      </div>
    </section>

    <section class="block">
      <p class="eyebrow">art sticker — hover or tab to peel</p>
      <div class="demo">
        {demo.map((artwork) => <ArtSticker artwork={artwork} loading="eager" />)}
      </div>
    </section>
  </main>
</Base>

<style>
  .sheet {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .badge-row,
  .nav-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xl);
  }

  .nav-row__word {
    display: block;
    padding: 0.1em 0.35em 0.22em;
    background: var(--wall);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 0.9;
  }

  .plates {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-md);
  }

  .plates li {
    display: grid;
    gap: var(--space-2xs);
  }

  .plates__chip {
    display: block;
    height: 4.5rem;
  }

  .plates__name {
    font-weight: 700;
  }

  .plates__hex {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    opacity: 0.6;
  }

  .scale li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-xs);
  }

  .scale__label {
    flex: 0 0 4.5rem;
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .scale__spec {
    line-height: 0.95;
    text-transform: lowercase;
  }

  .demo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-xl);
    align-items: start;
  }
</style>
